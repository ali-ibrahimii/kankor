{
	"name": "abzarkankor-web",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "NODE_OPTIONS='--inspect' next dev --webpack",
		"build": "next build",
		"analyze": "next experimental-analyze",
		"start": "next start",
		"lint": "biome check --write ./src",
		"check:types": "tsc --noEmit",
		"format:write": "prettier --write \"**/*.{ts,tsx,mdx}\" --cache",
		"check": "biome check --write ./src",
		"check:ci": "biome check --write ./src --diagnostic-level=error",
		"check:fix": "biome check ./src --unsafe --fix",
		"check:type": "tsc --noEmit",
		"format": "biome format --write ./src",
		"test": "dotenvx run -f .env -- vitest run",
		"test:watch": "dotenvx run -f .env -- vitest",
		"test:coverage": "dotenvx run -f .env -- vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"verify": "pnpm check:type && pnpm check && pnpm test",
		"push:config:production": "dotenvx run -f supabase/.env.production -- supabase config push",
		"push:db:production": "dotenvx run -f supabase/.env -- supabase db push --linked",
		"gen:types": "supabase gen types typescript --local --schema public > src/lib/supabase/database.types.ts && pnpm gen:table-schema",
		"gen:table-schema": "node scripts/generate-tables-metadata.js",
		"gen:routes": "node scripts/generate-routes.js",
		"setup:r2:cors": "dotenvx run -f .env -- node scripts/configure-r2-cors.js",
		"prepare": "lefthook install"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1086.0",
		"@aws-sdk/s3-request-presigner": "^3.1086.0",
