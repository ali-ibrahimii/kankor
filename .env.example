# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Abzar Kankor
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_EMAIL=hello@abzarkankor.com

# Optional: profile id used as the author of courses created from the admin
# panel, so the platform (not the signed-in admin) is shown as the creator.
# When empty, the admin profile named like the brand ("Abzar Kankor") is used.
PLATFORM_AUTHOR_PROFILE_ID=

# ── Supabase ─────────────────────────────────────────────────────────────────
# Paste the values from Supabase → Project Settings → API.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon / publishable key>
# SUPABASE_SERVICE_ROLE_KEY=<service_role key>   ← never commit this
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudflare R2 (storage) ──────────────────────────────────────────────────
# Private objects: lesson video/audio/documents/answer sheets (signed URLs).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional: defaults to https://{accountId}.r2.cloudflarestorage.com
R2_ENDPOINT=

# Public images (course covers, school covers/logos, avatars).
# This is the bucket's public host — an R2 custom domain such as
# img.abzarkankor.com, or the pub-xxxx.r2.dev host. It is NEXT_PUBLIC because
# the browser builds card URLs from it; leave it empty to serve the same
# objects through the same-origin /api/media proxy instead.
# See docs/cloudflare-images.md (includes the bucket CORS rules).
NEXT_PUBLIC_R2_PUBLIC_HOSTNAME=

# ── Optional integrations ────────────────────────────────────────────────────
OMR_SERVICE_URL=
OMR_INTERNAL_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT=
CRON_SECRET=

# ── E2E test credentials (optional) ──────────────────────────────────────────
# A super-admin account used by the Playwright suite (e2e/*.spec.ts).
# Without these the authenticated E2E tests are skipped and only the
# access-guard assertions run.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
